# Copy this file to .env and set your local values.
# Keep .env local and never commit it.

DB_HOST=camagru_db
DB_PORT=3306
DB_NAME=camagru
DB_USER=camagru
DB_PASS=change_this_password
MYSQL_HOST_PORT=3307
APP_URL=http://localhost:8080
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail-address@gmail.com
SMTP_PASS=your-16-character-app-password
SMTP_ENCRYPTION=tls
MAIL_FROM=your-gmail-address@gmail.com
MAIL_FROM_NAME=Camagru

# Gmail requires an app password, not your normal account password.
# If these values are missing, the app falls back to local mail output in /tmp/camagru-mail.

MYSQL_DATABASE=camagru
MYSQL_USER=camagru
MYSQL_PASSWORD=change_this_password
MYSQL_ROOT_PASSWORD=change_this_root_password
